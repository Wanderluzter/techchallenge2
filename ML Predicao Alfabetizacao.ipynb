   "source": [
    "# Modelo Preditivo — Alfabetização por Município\n",
    "**Tech Challenge Fase 2 | Expansão IA**\n",
    "\n",
    "Demonstra como a camada Gold pode alimentar modelos de machine learning para:\n",
    "- **Predição**: estimar a taxa de alfabetização futura de municípios\n",
    "- **Classificação**: identificar municípios em risco de não atingir a meta 2030\n",
    "- **Clustering**: agrupar municípios por perfil de desempenho\n",
    "\n",
    "## Abordagem\n",
    "1. Feature engineering a partir de `gold_indicador_municipio` e `gold_gap_meta_resultado`\n",
    "2. Modelo de classificação (Random Forest) para risco de meta 2030\n",
    "3. Tracking com MLflow\n",
    "4. Análise de importância de features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "6ef19c0c-5e6f-4020-b99b-6b387de8a7ac",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "Setup e Dados"
    }
   },
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# SETUP — Carregar dados da pipeline principal\n",
    "# =============================================================================\n",
    "%run \"./Pipeline Alfabetizacao Brasil Tech Challenge\"\n",
    "\n",
    "import mlflow\n",
    "import mlflow.sklearn\n",
    "from sklearn.ensemble import RandomForestClassifier, GradientBoostingRegressor\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import classification_report, accuracy_score, f1_score\n",
    "import numpy as np\n",
    "\n",
    "mlflow.set_experiment(\"/Users/leobotelho27@outlook.com/techchallenge2/ml_alfabetizacao")\n",
    "print(\"✅ Setup completo. Dados Gold disponíveis.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "23b3a0b2-ad1a-46dd-9469-7e8f8e10f3b6",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "Feature Engineering"
    }
   },
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# FEATURE ENGINEERING\n",
    "# =============================================================================\n",
    "\n",
    "# Unir indicadores com gap de metas para criar features\n",
    "df_features = (\n",
    "    gold_gap_meta_resultado\n",
    "    .select(\n",
    "        \"ano\", \"id_municipio\", \"rede\",\n",
    "        \"taxa_realizada\",\n",
    "        \"meta_alfabetizacao_2024\", \"meta_alfabetizacao_2030\",\n",
    "        \"gap_meta_2024\", \"gap_meta_2030\",\n",
    "        \"acima_meta_2024\"\n",
    "    )\n",
    "    .filter(F.col(\"meta_alfabetizacao_2030\").isNotNull())\n",
    ")\n",
    "\n",
    "# Criar target: municipío atingirá meta 2030?\n",
    "# Heurística: se taxa_realizada >= meta_2030 OU gap < 5pp, classifica como \"no caminho\"\n",
    "df_ml = (\n",
    "    df_features\n",
    "    .withColumn(\"target_meta_2030\",\n",
    "        F.when(F.col(\"taxa_realizada\") >= F.col(\"meta_alfabetizacao_2030\"), 1)\n",
    "         .when(F.col(\"gap_meta_2030\") <= 5.0, 1)\n",
    "         .otherwise(0)\n",
    "    )\n",
    "    .withColumn(\"distancia_meta_pct\",\n",
    "        F.round((F.col(\"meta_alfabetizacao_2030\") - F.col(\"taxa_realizada\")) / F.col(\"meta_alfabetizacao_2030\") * 100, 2)\n",
    "    )\n",
    ")\n",
    "\n",
    "# Converter para Pandas para sklearn\n",
    "pdf = df_ml.toPandas()\n",
    "\n",
    "# Features numéricas\n",
    "feature_cols = [\"taxa_realizada\", \"gap_meta_2024\", \"gap_meta_2030\", \"distancia_meta_pct\",\n",
    "                \"meta_alfabetizacao_2024\", \"meta_alfabetizacao_2030\"]\n",
    "target_col = \"target_meta_2030\"\n",
    "\n",
    "# Remover NaN\n",
    "pdf_clean = pdf.dropna(subset=feature_cols + [target_col])\n",
    "print(f\"Dataset ML: {len(pdf_clean)} registros\")\n",
    "print(f\"Distribuição target (1=atingirá meta): \\n{pdf_clean[target_col].value_counts()}\")\n",
    "print(f\"\\nFeatures: {feature_cols}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "22a4e329-16ab-48fb-8214-b5b56b2340bc",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "Treinamento com MLflow"
    }
   },
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# TREINAMENTO — Random Forest + MLflow Tracking\n",
    "# =============================================================================\n",
    "\n",
    "X = pdf_clean[feature_cols].values\n",
    "y = pdf_clean[target_col].values\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42, stratify=y)\n",
    "\n",
    "with mlflow.start_run(run_name=\"rf_meta2030_classificacao\"):\n",
    "    # Hiperparâmetros\n",
    "    params = {\"n_estimators\": 100, \"max_depth\": 8, \"min_samples_leaf\": 5, \"random_state\": 42}\n",
    "    mlflow.log_params(params)\n",
    "    mlflow.log_param(\"features\", feature_cols)\n",
    "    mlflow.log_param(\"target\", target_col)\n",
    "    mlflow.log_param(\"train_size\", len(X_train))\n",
    "    mlflow.log_param(\"test_size\", len(X_test))\n",
    "    \n",
    "    # Treinar\n",
    "    model = RandomForestClassifier(**params)\n",
    "    model.fit(X_train, y_train)\n",
    "    \n",
    "    # Avaliar\n",
    "    y_pred = model.predict(X_test)\n",
    "    acc = accuracy_score(y_test, y_pred)\n",
    "    f1 = f1_score(y_test, y_pred, average=\"weighted\")\n",
    "    \n",
    "    mlflow.log_metric(\"accuracy\", acc)\n",
    "    mlflow.log_metric(\"f1_weighted\", f1)\n",
    "    mlflow.sklearn.log_model(model, \"model\")\n",
    "    \n",
    "    print(f\"\\n✅ Modelo treinado e registrado no MLflow\")\n",
    "    print(f\"   Acurácia: {acc:.4f}\")\n",
    "    print(f\"   F1 (weighted): {f1:.4f}\")\n",
    "    print(f\"\\n{classification_report(y_test, y_pred, target_names=['Risco', 'No caminho'])}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
