   "source": [
    "# =============================================================================\n",
    "# PREDIÇÃO E INSIGHTS\n",
    "# =============================================================================\n",
    "\n",
    "# Aplicar modelo em todos os municípios\n",
    "pdf_clean[\"pred_meta_2030\"] = model.predict(pdf_clean[feature_cols].values)\n",
    "pdf_clean[\"prob_atingir\"] = model.predict_proba(pdf_clean[feature_cols].values)[:, 1]\n",
    "\n",
    "# Municípios em maior risco\n",
    "risco = pdf_clean[pdf_clean[\"prob_atingir\"] < 0.3].sort_values(\"prob_atingir\")\n",
    "\n",
    "print(f\"\\n=== MUNICÍPIOS EM RISCO (prob < 30% de atingir meta 2030) ===\")\n",
    "print(f\"Total: {len(risco)} municípios\")\n",
    "print(f\"\\nTaxa média realizada: {risco['taxa_realizada'].mean():.1f}%\")\n",
    "print(f\"Gap médio para 2030: {risco['gap_meta_2030'].mean():.1f} pp\")\n",
    "\n",
    "# Converter de volta para Spark e display\n",
    "df_risco = spark.createDataFrame(risco[[\"id_municipio\", \"rede\", \"taxa_realizada\", \"meta_alfabetizacao_2030\", \"gap_meta_2030\", \"prob_atingir\"]].head(20))\n",
    "print(\"\\nTop 20 municípios com maior risco:\")\n",
    "display(df_risco)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"CONCLUSÃO: O modelo demonstra que a camada Gold pode alimentar\")\n",
    "print(\"sistemas preditivos para priorização de políticas educacionais.\")\n",
    "print(\"=\"*60)"
   ]
  }
