     "title": "Importancia de Features"
    }
   },
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# ANÁLISE DE IMPORTÂNCIA DE FEATURES\n",
    "# =============================================================================\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "importances = model.feature_importances_\n",
    "sorted_idx = np.argsort(importances)[::-1]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "ax.barh(range(len(feature_cols)), importances[sorted_idx], color=\"steelblue\")\n",
    "ax.set_yticks(range(len(feature_cols)))\n",
    "ax.set_yticklabels([feature_cols[i] for i in sorted_idx])\n",
    "ax.set_xlabel(\"Importância\")\n",
    "ax.set_title(\"Importância das Features — Predição Meta 2030\")\n",
    "ax.invert_yaxis()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n=== Ranking de Importância ===\")\n",
    "for i in sorted_idx:\n",
    "    print(f\"  {feature_cols[i]:30s} {importances[i]:.4f}\")"
   ]
  },
